---
import { siteConfig } from "@data/site";

type Props = {
  className?: string;
};

const { className = "" } = Astro.props;

const iconMap = {
  Threads: "threads",
  Instagram: "instagram",
  TikTok: "tiktok",
  X: "x",
  Bluesky: "bluesky",
  Substack: "substack",
} as const;
---

<div class:list={["social-links", className]} aria-label="House Pendale socials">
  {
    siteConfig.socialLinks.map((link) => (
      <a
        class="social-link"
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={link.label}
      >
        <span
          class:list={["social-icon", `social-icon-${iconMap[link.label]}`]}
          aria-hidden="true"
        />
      </a>
    ))
  }
</div>
