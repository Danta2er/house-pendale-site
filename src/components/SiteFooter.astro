---
import SocialLinks from "@components/SocialLinks.astro";
---

<footer class="site-footer">
  <div class="page-shell footer-shell">
    <div class="footer-top">
      <SocialLinks />
      <div class="footer-copy-block">
        <p class="footer-copy">© 2026 House Pendale. All rights reserved.</p>
        <p class="footer-note-link">
          <a href="https://liorapendale.substack.com" target="_blank" rel="noopener noreferrer">
            Read the Notes on Substack
          </a>
        </p>
        <p class="footer-disclaimer">
          18+ content. By entering, you confirm you are 18 years of age or older.
        </p>
      </div>
      <img
        class="footer-mark"
        src="/images/HousePendaleMonogram.png"
        alt="House Pendale monogram"
      />
    </div>
  </div>
</footer>
