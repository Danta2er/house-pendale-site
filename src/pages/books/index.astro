---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroBlock from "@components/HeroBlock.astro";
import SectionBlock from "@components/SectionBlock.astro";
import FeaturedBookCard from "@components/FeaturedBookCard.astro";
import { siteConfig } from "@data/site";
import { personSchema, websiteSchema } from "@utils/schemas";

const page = await getEntry("pages", "books");
const books = await getCollection("books");
const featured = books[0];

if (!page || !featured) {
  throw new Error("Missing books collection content.");
}

const schema = [
  websiteSchema({
    name: siteConfig.name,
    url: siteConfig.canonicalUrl,
    description: siteConfig.description,
  }),
  personSchema({
    name: siteConfig.author,
    url: siteConfig.canonicalUrl,
  }),
];
---

<BaseLayout
  title={page.data.meta.title}
  description={page.data.meta.description}
  ogImage={page.data.meta.ogImage}
  canonicalPath="/books/"
  schema={schema}
>
  <HeroBlock {...page.data.hero} compact />
  <SectionBlock section={page.data.sections[0]} />

  <section class="section-block">
    <FeaturedBookCard
      title={featured.data.title}
      body={page.data.sections[1].body}
      status={featured.data.status}
      href={featured.data.route}
    />
  </section>

  <SectionBlock section={page.data.sections[2]} />
  <SectionBlock section={page.data.sections[3]} reverse />
</BaseLayout>
