---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroBlock from "@components/HeroBlock.astro";
import SectionBlock from "@components/SectionBlock.astro";
import SystemGrid from "@components/SystemGrid.astro";
import { personSchema, websiteSchema } from "@utils/schemas";
import { siteConfig } from "@data/site";

const page = await getEntry("pages", "magic-systems");
const systems = (await getCollection("systems")).sort((a, b) => a.data.order - b.data.order);

if (!page) {
  throw new Error("Missing magic systems page entry.");
}

const schema = [
  websiteSchema({
    name: siteConfig.name,
    url: siteConfig.canonicalUrl,
    description: siteConfig.description,
  }),
  personSchema({
    name: siteConfig.author,
    url: siteConfig.canonicalUrl,
  }),
];
---

<BaseLayout
  title={page.data.meta.title}
  description={page.data.meta.description}
  ogImage={page.data.meta.ogImage}
  canonicalPath="/magic-systems/"
  schema={schema}
>
  <HeroBlock {...page.data.hero} compact />
  <SectionBlock section={page.data.sections[0]} />
  <SystemGrid systems={systems} />
  <SectionBlock section={page.data.sections[1]} />
  <SectionBlock section={page.data.sections[2]} reverse />
</BaseLayout>
